# MongoDB connection string (Atlas free M0 cluster works fine)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tabboush
# Secret for signing customer session tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Code the restaurant staff enter to view the orders page
STAFF_CODE=change-me
# Optional: port for the local API dev server (default 5000)
PORT=5000
